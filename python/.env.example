# Application
ALLOWED_ORIGINS=["http://localhost:3000"]
CATALOG_ADMIN_TOKEN=

# TMDB
TMDB_API_KEY=

# Recommendation AI
RECOMMENDATION_AI_PROVIDER=ollama

# Ollama (local development)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_RERANKING_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT=120
OLLAMA_RERANKING_TIMEOUT=180

# Cloudflare Workers AI (production)
CLOUDFLARE_AI_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_AI_EMBEDDING_MODEL=@cf/qwen/qwen3-embedding-0.6b
CLOUDFLARE_AI_GENERATION_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
CLOUDFLARE_AI_TIMEOUT=120

# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=catalogue-zen
CLOUDFLARE_R2_CATALOG_KEY=catalog.json
CLOUDFLARE_R2_ENDPOINT_URL=
CLOUDFLARE_R2_CONNECT_TIMEOUT=5
CLOUDFLARE_R2_READ_TIMEOUT=10
CLOUDFLARE_R2_MAX_RETRIES=1

# Palette extraction
COLORS_PER_IMAGE=12
MAX_IMAGES=3
DOWNLOAD_TIMEOUT=10
